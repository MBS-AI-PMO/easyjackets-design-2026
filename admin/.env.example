# Copy to .env (git-ignored). On localhost the app talks to the local backend by default.
REACT_APP_LOCAL_API_URL=http://localhost:8080/api/v1
# Production (Coolify build args, see Dockerfile): the NEW backend and storefront
REACT_APP_API_URL=https://api2.easyjackets.com/api/v1
REACT_APP_FRONTEND_URL=https://new.easyjackets.com
# Order details link to products on this storefront
REACT_APP_STOREFRONT_URL=https://new.easyjackets.com
REACT_APP_CUSTOM_URL=https://custom.easyjackets.com
# Force the live/local choice regardless of hostname: true | false
# REACT_APP_USE_LOCAL_BACKEND=true
