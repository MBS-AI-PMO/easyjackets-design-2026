<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body { margin: 0; padding: 0; background: #ffffff; color: #211d18; font-family: Arial, Helvetica, sans-serif; }
        table { border-collapse: collapse; }
        .wrapper { width: 100%; background: #ffffff; padding: 28px 12px; }
        .card { width: 100%; max-width: 560px; margin: 0 auto; background: #fffaf2; border: 1px solid #e4d6c3; border-radius: 18px; overflow: hidden; box-shadow: 0 18px 50px rgba(33,29,24,.10); }
        .hero { background: #11100e; padding: 34px; color: #f5eee3; }
        .eyebrow { margin: 0 0 12px; color: #c4703a; font-size: 11px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; }
        h1 { margin: 0; font-family: Georgia, 'Times New Roman', serif; font-size: 34px; line-height: 1.05; font-weight: 400; letter-spacing: -.03em; }
        .content { padding: 32px; }
        p { margin: 0 0 18px; color: #5f574c; font-size: 15px; line-height: 1.75; }
        .action { text-align: center; margin: 26px 0; }
        .button { display: inline-block; background: #c4703a; color: #ffffff !important; text-decoration: none; font-weight: 700; font-size: 15px; padding: 14px 28px; border-radius: 10px; }
        .link { word-break: break-all; font-size: 12px; color: #8a7f71; }
        .footer { background: #11100e; color: rgba(245,238,227,.56); padding: 22px 32px; font-size: 12px; line-height: 1.7; }
        .footer strong { color: #f5eee3; }
        @media only screen and (max-width: 520px) { .wrapper { padding: 18px 10px !important; } .hero, .content, .footer { padding-left: 22px !important; padding-right: 22px !important; } h1 { font-size: 29px !important; } }
    </style>
</head>

<body>
    <table class="wrapper" role="presentation" width="100%">
        <tr>
            <td>
                <table class="card" role="presentation" width="100%">
                    <tr>
                        <td class="hero">
                            <p class="eyebrow">Your account</p>
                            <h1>Reset your password.</h1>
                        </td>
                    </tr>
                    <tr>
                        <td class="content">
                            <p>Hello<%= data.name ? ' ' + data.name : '' %>,</p>
                            <p>Someone asked to reset the password of your Easy Jackets account. Use the button below to choose a new one.</p>
                            <div class="action">
                                <a class="button" href="<%= data.link %>">Choose a new password</a>
                            </div>
                            <p>The link works once and expires in <%= data.minutes %> minutes. If you did not ask for this, ignore this email: your password stays as it is.</p>
                            <p class="link"><%= data.link %></p>
                        </td>
                    </tr>
                    <tr>
                        <td class="footer">
                            <strong>Easy Jackets</strong><br>
                            Account security.
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>

</html>
