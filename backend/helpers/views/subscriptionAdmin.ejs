<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body {
            margin: 0;
            padding: 0;
            background: #ffffff;
            color: #211d18;
            font-family: Arial, Helvetica, sans-serif;
        }

        table {
            border-collapse: collapse;
        }

        .wrapper {
            width: 100%;
            background: #ffffff;
            padding: 28px 12px;
        }

        .email-card {
            width: 100%;
            max-width: 620px;
            margin: 0 auto;
            background: #fffaf2;
            border: 1px solid #e4d6c3;
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 18px 50px rgba(33, 29, 24, 0.10);
        }

        .header {
            background: #11100e;
            color: #f5eee3;
            padding: 30px 32px;
        }

        .eyebrow {
            color: #c4703a;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            margin: 0 0 12px;
        }

        h1 {
            margin: 0;
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 32px;
            line-height: 1.08;
            font-weight: 400;
            letter-spacing: -0.03em;
        }

        .content {
            padding: 32px;
        }

        .content p {
            margin: 0 0 18px;
            color: #5f574c;
            font-size: 15px;
            line-height: 1.7;
        }

        .detail-card {
            background: #f1e6d7;
            border: 1px solid #e2d2bd;
            border-radius: 14px;
            padding: 22px;
            margin: 20px 0;
        }

        .label {
            color: #8a7c6d;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            margin-bottom: 6px;
        }

        .value {
            color: #211d18;
            font-size: 18px;
            font-weight: 700;
            line-height: 1.35;
            word-break: break-word;
        }

        .meta-row {
            padding-top: 16px;
            margin-top: 16px;
            border-top: 1px solid rgba(33, 29, 24, 0.10);
        }

        .footer {
            background: #11100e;
            color: rgba(245, 238, 227, 0.56);
            padding: 20px 32px;
            font-size: 12px;
            line-height: 1.7;
        }

        @media only screen and (max-width: 520px) {
            .header,
            .content,
            .footer {
                padding-left: 22px;
                padding-right: 22px;
            }

            h1 {
                font-size: 28px;
            }
        }
    </style>
</head>

<body>
    <table class="wrapper" role="presentation" width="100%">
        <tr>
            <td>
                <table class="email-card" role="presentation">
                    <tr>
                        <td class="header">
                            <p class="eyebrow">Newsletter Signup</p>
                            <h1>A new subscriber joined Easy Jackets.</h1>
                        </td>
                    </tr>
                    <tr>
                        <td class="content">
                            <p>
                                Someone subscribed through the Easy Jackets website newsletter form.
                            </p>

                            <div class="detail-card">
                                <div class="label">Subscriber Email</div>
                                <div class="value"><%= data.email %></div>

                                <div class="meta-row">
                                    <div class="label">Subscription Date</div>
                                    <div class="value" style="font-size:16px;"><%= data.date %></div>
                                </div>
                            </div>

                            <p style="font-size:13px;color:#8a7c6d;">
                                This email was generated automatically so the team can track new newsletter interest.
                            </p>
                        </td>
                    </tr>
                    <tr>
                        <td class="footer">
                            Easy Jackets admin notification
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>

</html>
