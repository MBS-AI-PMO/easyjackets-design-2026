<%
  // New newsletter subscriber, to the team (POST /features/subscribe). Bulk quote email design.
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light only">
  <title>New newsletter subscriber</title>
  <style>
    body { margin: 0; padding: 0; background: #f4efe6; -webkit-text-size-adjust: 100%; }
    table { border-collapse: collapse; }
    @media only screen and (max-width: 560px) {
      .px { padding-left: 22px !important; padding-right: 22px !important; }
      .h1 { font-size: 26px !important; }
      .row td { display: block !important; width: auto !important; padding: 2px 0 !important; }
      .row td.k { padding-top: 12px !important; }
    }
  </style>
</head>
<body style="margin:0;padding:0;background:#f4efe6;">
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;"><%= data.email %> joined the Easy Jackets newsletter.</div>
  <table role="presentation" width="100%" style="background:#f4efe6;">
    <tr><td align="center" style="padding:28px 12px;">
      <table role="presentation" width="100%" style="max-width:620px;background:#fbf8f2;border:1px solid #e9e1d2;border-radius:6px;overflow:hidden;">
        <tr><td style="height:6px;background:#c9a227;line-height:6px;font-size:0;">&nbsp;</td></tr>
        <tr><td class="px" style="background:#14110f;padding:28px 36px 32px;">
          <div style="font-family:Arial,Helvetica,sans-serif;font-size:11px;font-weight:700;letter-spacing:.18em;color:#c9a227;text-transform:uppercase;">New newsletter subscriber</div>
          <div class="h1" style="margin-top:12px;font-family:'Arial Narrow','Helvetica Neue',Arial,sans-serif;font-size:32px;line-height:1.05;font-weight:800;color:#f4efe6;word-break:break-all;"><%= data.email %></div>
        </td></tr>
        <tr><td class="px" style="padding:26px 36px 0;">
          <div style="font-family:Arial,Helvetica,sans-serif;font-size:11px;font-weight:700;letter-spacing:.16em;color:#a8861c;text-transform:uppercase;padding-bottom:10px;border-bottom:2px solid #14110f;">Details</div>
          <table role="presentation" width="100%" style="font-family:Arial,Helvetica,sans-serif;">
            <tr class="row">
              <td class="k" width="32%" style="padding:11px 12px 11px 0;border-bottom:1px solid #e9e1d2;font-size:13px;color:#6b635a;">Email</td>
              <td style="padding:11px 0;border-bottom:1px solid #e9e1d2;font-size:14px;font-weight:700;"><a href="mailto:<%= data.email %>" style="color:#14110f;text-decoration:underline;text-decoration-color:#c9a227;"><%= data.email %></a></td>
            </tr>
            <% if (data.date) { %>
            <tr class="row">
              <td class="k" width="32%" style="padding:11px 12px 11px 0;border-bottom:1px solid #e9e1d2;font-size:13px;color:#6b635a;">Subscribed</td>
              <td style="padding:11px 0;border-bottom:1px solid #e9e1d2;font-size:14px;font-weight:700;color:#14110f;"><%= data.date %></td>
            </tr>
            <% } %>
            <tr class="row">
              <td class="k" width="32%" style="padding:11px 12px 11px 0;border-bottom:1px solid #e9e1d2;font-size:13px;color:#6b635a;">Signed up from</td>
              <td style="padding:11px 0;border-bottom:1px solid #e9e1d2;font-size:14px;font-weight:700;color:#14110f;">Website footer (newsletter)</td>
            </tr>
          </table>
        </td></tr>
        <tr><td class="px" style="padding:22px 36px 30px;">
          <a href="mailto:<%= data.email %>?subject=<%= encodeURIComponent('Welcome to Easy Jackets') %>" style="display:inline-block;padding:13px 20px;background:#14110f;color:#f4efe6;text-decoration:none;font-family:Arial,Helvetica,sans-serif;font-size:13px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;border-radius:2px;">Email them</a>
          <p style="margin:18px 0 0;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:1.6;color:#6b635a;">They have been sent the welcome email.</p>
        </td></tr>
        <tr><td style="background:#14110f;padding:16px 36px;font-family:Arial,Helvetica,sans-serif;font-size:12px;letter-spacing:.14em;font-weight:900;color:#f4efe6;">EASY JACKETS</td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
