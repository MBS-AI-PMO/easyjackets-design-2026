<%
  // New bulk quote, to the team (POST /order/bulk). Contact first (reply / call in one tap), then the
  // request exactly as the customer filled it in. Table layout for mail clients; storefront colours.
  var first = String(data.name || '').trim().split(/\s+/)[0] || 'there';
  var cap = function (s) { s = String(s || ''); return s.charAt(0).toUpperCase() + s.slice(1); };
  var label = function (key) { return String(key).replace(/([A-Z])/g, ' $1').replace(/^./, function (c) { return c.toUpperCase(); }); };
  var spots = Object.keys(data.designLocations || {}).filter(function (k) { return data.designLocations[k]; }).map(label);
  var needed = '';
  if (data.neededBy) { var d = new Date(data.neededBy + 'T00:00:00'); needed = isNaN(d) ? data.neededBy : d.toLocaleDateString('en-US', { weekday: 'short', month: 'long', day: 'numeric', year: 'numeric' }); }
  var when = data.createdAt ? new Date(data.createdAt).toLocaleString('en-US', { dateStyle: 'full', timeStyle: 'short' }) : '';
  var ref = data.referenceId ? String(data.referenceId) : '';
  var qty = data.quantityRange ? data.quantityRange + ' jackets' : (data.quantity ? data.quantity + ' jackets' : '');
  var subject = encodeURIComponent('Your Easy Jackets bulk quote' + (data.organization ? ' for ' + data.organization : ''));
  var tel = String(data.phone || '').replace(/[^0-9+]/g, '');
  var contact = [
    ['Name', data.name, ''],
    ['Email', data.email, data.email ? 'mailto:' + data.email + '?subject=' + subject : ''],
    ['Phone', data.phone, tel ? 'tel:' + tel : ''],
    ['Country', data.country, ''],
  ].filter(function (r) { return r[1]; });
  var rows = [
    ['Organisation', data.organization ? data.organization + (data.orderType ? ' · ' + data.orderType : '') : ''],
    ['Jacket', data.selectedProduct],
    ['Quantity', qty],
    ['Front closure', cap(data.selectedClosure)],
    ['Lining', data.selectedLining],
    ['½ Zipout lining', data.zipoutLining ? 'Yes' : 'No'],
    ['Flap closure', data.flapClosure ? 'Yes' : 'No'],
    ['Needed by', needed],
    ['Budget per jacket', data.budget],
  ].filter(function (r) { return r[1]; });
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light only">
  <title>New bulk quote</title>
  <style>
    body { margin: 0; padding: 0; background: #f4efe6; -webkit-text-size-adjust: 100%; }
    table { border-collapse: collapse; }
    @media only screen and (max-width: 560px) {
      .px { padding-left: 22px !important; padding-right: 22px !important; }
      .h1 { font-size: 32px !important; }
      .row td { display: block !important; width: auto !important; padding: 2px 0 !important; }
      .row td.k { padding-top: 12px !important; }
    }
  </style>
</head>
<body style="margin:0;padding:0;background:#f4efe6;">
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;"><%= qty %> × <%= data.selectedProduct %><% if (data.organization) { %> for <%= data.organization %><% } %><% if (needed) { %>, needed by <%= needed %><% } %>.</div>
  <table role="presentation" width="100%" style="background:#f4efe6;">
    <tr><td align="center" style="padding:28px 12px;">
      <table role="presentation" width="100%" style="max-width:620px;background:#fbf8f2;border:1px solid #e9e1d2;border-radius:6px;overflow:hidden;">
        <tr><td style="height:6px;background:#c9a227;line-height:6px;font-size:0;">&nbsp;</td></tr>
        <!-- header -->
        <tr><td class="px" style="background:#14110f;padding:28px 36px 32px;">
          <div style="font-family:Arial,Helvetica,sans-serif;font-size:11px;font-weight:700;letter-spacing:.18em;color:#c9a227;text-transform:uppercase;">New bulk quote<% if (data.orderType) { %> · <%= data.orderType %><% } %></div>
          <div class="h1" style="margin-top:10px;font-family:'Arial Narrow','Helvetica Neue',Arial,sans-serif;font-size:40px;line-height:.98;font-weight:800;color:#f4efe6;text-transform:uppercase;"><%= data.organization || data.name %></div>
          <div style="margin-top:12px;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:700;color:#f4efe6;"><%= qty %> <span style="color:#c9a227;">×</span> <%= data.selectedProduct %></div>
          <% if (needed || data.budget) { %><div style="margin-top:6px;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:rgba(244,239,230,.62);"><% if (needed) { %>Needed by <%= needed %><% } %><% if (needed && data.budget) { %> · <% } %><% if (data.budget) { %>Budget <%= data.budget %> per jacket<% } %></div><% } %>
        </td></tr>
        <!-- contact -->
        <tr><td class="px" style="padding:26px 36px 0;">
          <div style="font-family:Arial,Helvetica,sans-serif;font-size:11px;font-weight:700;letter-spacing:.16em;color:#a8861c;text-transform:uppercase;padding-bottom:10px;border-bottom:2px solid #14110f;">Customer</div>
          <table role="presentation" width="100%" style="font-family:Arial,Helvetica,sans-serif;">
            <% contact.forEach(function (r) { %>
            <tr class="row">
              <td class="k" width="32%" style="padding:11px 12px 11px 0;border-bottom:1px solid #e9e1d2;font-size:13px;color:#6b635a;"><%= r[0] %></td>
              <td style="padding:11px 0;border-bottom:1px solid #e9e1d2;font-size:14px;font-weight:700;color:#14110f;"><% if (r[2]) { %><a href="<%= r[2] %>" style="color:#14110f;text-decoration:underline;text-decoration-color:#c9a227;"><%= r[1] %></a><% } else { %><%= r[1] %><% } %></td>
            </tr>
            <% }); %>
          </table>
          <table role="presentation" style="margin-top:18px;"><tr>
            <% if (data.email) { %><td style="padding-right:10px;"><a href="mailto:<%= data.email %>?subject=<%= subject %>" style="display:inline-block;padding:13px 20px;background:#14110f;color:#f4efe6;text-decoration:none;font-family:Arial,Helvetica,sans-serif;font-size:13px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;border-radius:2px;">Reply to <%= first %></a></td><% } %>
            <% if (tel) { %><td><a href="tel:<%= tel %>" style="display:inline-block;padding:11px 18px;border:2px solid #14110f;color:#14110f;text-decoration:none;font-family:Arial,Helvetica,sans-serif;font-size:13px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;border-radius:2px;">Call</a></td><% } %>
          </tr></table>
        </td></tr>
        <!-- request -->
        <tr><td class="px" style="padding:28px 36px 0;">
          <div style="font-family:Arial,Helvetica,sans-serif;font-size:11px;font-weight:700;letter-spacing:.16em;color:#a8861c;text-transform:uppercase;padding-bottom:10px;border-bottom:2px solid #14110f;">Request</div>
          <table role="presentation" width="100%" style="font-family:Arial,Helvetica,sans-serif;">
            <% rows.forEach(function (r) { %>
            <tr class="row">
              <td class="k" width="42%" style="padding:11px 12px 11px 0;border-bottom:1px solid #e9e1d2;font-size:13px;color:#6b635a;vertical-align:top;"><%= r[0] %></td>
              <td style="padding:11px 0;border-bottom:1px solid #e9e1d2;font-size:14px;font-weight:700;color:#14110f;vertical-align:top;"><%= r[1] %></td>
            </tr>
            <% }); %>
          </table>
        </td></tr>
        <tr><td class="px" style="padding:20px 36px 0;font-family:Arial,Helvetica,sans-serif;">
          <div style="font-size:13px;color:#6b635a;margin-bottom:10px;">Design locations (<%= spots.length %>)</div>
          <% if (spots.length) { %>
            <% spots.forEach(function (s) { %><span style="display:inline-block;margin:0 6px 8px 0;padding:6px 12px;border-radius:2px;background:#14110f;color:#f4efe6;font-size:12px;font-weight:700;"><%= s %></span><% }); %>
          <% } else { %><span style="font-size:14px;color:#2a2521;">None chosen.</span><% } %>
        </td></tr>
        <% if (data.message) { %>
        <tr><td class="px" style="padding:18px 36px 0;font-family:Arial,Helvetica,sans-serif;">
          <div style="font-size:13px;color:#6b635a;margin-bottom:8px;">Customer's notes</div>
          <div style="padding:14px 16px;border-left:3px solid #c9a227;background:#f4efe6;font-size:14px;line-height:1.65;color:#2a2521;white-space:pre-line;"><%= data.message %></div>
        </td></tr>
        <% } %>
        <% if (Array.isArray(data.images) && data.images.length) { %>
        <tr><td class="px" style="padding:18px 36px 0;font-family:Arial,Helvetica,sans-serif;">
          <div style="font-size:13px;color:#6b635a;margin-bottom:8px;">Attached files (<%= data.images.length %>)</div>
          <% data.images.forEach(function (u, i) { %><div style="font-size:14px;margin-bottom:4px;"><a href="<%= u %>" style="color:#a8861c;">File <%= i + 1 %></a></div><% }); %>
        </td></tr>
        <% } %>
        <!-- footer -->
        <tr><td class="px" style="padding:26px 36px 28px;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:1.6;color:#6b635a;">
          Saved in the admin under Orders → Bulk Order<% if (when) { %> · received <%= when %><% } %><% if (ref) { %><br>Reference <%= ref %><% } %>
        </td></tr>
        <tr><td style="background:#14110f;padding:16px 36px;font-family:Arial,Helvetica,sans-serif;font-size:12px;letter-spacing:.14em;font-weight:900;color:#f4efe6;">EASY JACKETS</td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
