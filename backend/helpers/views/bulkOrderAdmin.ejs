<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Bulk Order Request</title>
    <style>
        body { margin: 0; padding: 0; background: #ffffff; color: #211d18; font-family: Arial, Helvetica, sans-serif; }
        table { border-collapse: collapse; }
        .wrapper { width: 100%; background: #ffffff; padding: 28px 12px; }
        .card { width: 100%; max-width: 680px; margin: 0 auto; background: #fffaf2; border: 1px solid #e4d6c3; border-radius: 18px; overflow: hidden; box-shadow: 0 18px 50px rgba(33,29,24,.10); }
        .hero { background: #11100e; padding: 34px; color: #f5eee3; }
        .eyebrow { margin: 0 0 12px; color: #c4703a; font-size: 11px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; }
        h1 { margin: 0; font-family: Georgia, 'Times New Roman', serif; font-size: 36px; line-height: 1.04; font-weight: 400; letter-spacing: -.03em; }
        .content { padding: 32px; }
        .panel { background: #ffffff; border: 1px solid #eadfce; border-radius: 14px; padding: 20px; margin: 0 0 18px; }
        .panel.alt { background: #f1e6d7; border-color: #e2d2bd; }
        .title { margin: 0 0 14px; color: #c4703a; font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
        .row { border-top: 1px solid rgba(33,29,24,.09); }
        .row:first-of-type { border-top: 0; }
        .label { padding: 10px 0; color: #8a7c6d; font-size: 13px; width: 45%; vertical-align: top; }
        .value { padding: 10px 0; color: #211d18; font-size: 13px; font-weight: 700; text-align: right; vertical-align: top; word-break: break-word; }
        .message { white-space: pre-line; color: #433b32; font-size: 14px; line-height: 1.65; }
        .footer { background: #11100e; color: rgba(245,238,227,.56); padding: 22px 32px; font-size: 12px; line-height: 1.7; }
        .footer strong { color: #f5eee3; }
        a { color: #c4703a; text-decoration: none; }
        @media only screen and (max-width: 560px) { .wrapper { padding: 18px 10px !important; } .hero, .content, .footer { padding-left: 22px !important; padding-right: 22px !important; } h1 { font-size: 30px !important; } .label, .value { display: block !important; width: 100% !important; text-align: left !important; padding-bottom: 2px !important; } .value { padding-top: 0 !important; } }
    </style>
</head>

<body>
    <table class="wrapper" role="presentation" width="100%">
        <tr>
            <td>
                <table class="card" role="presentation" width="100%">
                    <tr>
                        <td class="hero">
                            <p class="eyebrow">Bulk Order Request</p>
                            <h1>A new quote request came in.</h1>
                        </td>
                    </tr>
                    <tr>
                        <td class="content">
                            <div class="panel alt">
                                <p class="title">Customer Information</p>
                                <table role="presentation" width="100%">
                                    <tr class="row"><td class="label">Name</td><td class="value"><%= data.name || 'Not provided' %></td></tr>
                                    <tr class="row"><td class="label">Email</td><td class="value"><a href="mailto:<%= data.email %>"><%= data.email %></a></td></tr>
                                    <tr class="row"><td class="label">Phone</td><td class="value"><%= data.phone || 'Not provided' %></td></tr>
                                    <tr class="row"><td class="label">Country</td><td class="value"><%= data.country || 'Not provided' %></td></tr>
                                    <% if (data.createdAt) { %>
                                    <tr class="row"><td class="label">Submitted</td><td class="value"><%= new Date(data.createdAt).toUTCString() %></td></tr>
                                    <% } %>
                                    <% if (data.referenceId) { %>
                                    <tr class="row"><td class="label">Reference</td><td class="value"><%= data.referenceId %></td></tr>
                                    <% } %>
                                </table>
                            </div>

                            <div class="panel">
                                <p class="title">Product Details</p>
                                <table role="presentation" width="100%">
                                    <tr class="row"><td class="label">Product</td><td class="value"><%= data.selectedProduct %></td></tr>
                                    <tr class="row"><td class="label">Quantity</td><td class="value"><%= data.quantity %> pieces</td></tr>
                                    <tr class="row"><td class="label">Front Closure</td><td class="value"><%= data.selectedClosure %></td></tr>
                                    <tr class="row"><td class="label">Lining</td><td class="value"><%= data.selectedLining %></td></tr>
                                    <tr class="row"><td class="label">Zipout Lining</td><td class="value"><%= data.zipoutLining ? 'Yes' : 'No' %></td></tr>
                                    <tr class="row"><td class="label">Flap Closure</td><td class="value"><%= data.flapClosure ? 'Yes' : 'No' %></td></tr>
                                </table>
                            </div>

<%
    // The form posts every location as true/false, so listing them all buries the few
    // the customer actually picked. Show the selected ones first and label the rest.
    var locationEntries = Object.entries(data.designLocations || {});
    var chosenLocations = locationEntries.filter(function (e) { return e[1]; });
    var skippedLocations = locationEntries.filter(function (e) { return !e[1]; });
    var prettyLocation = function (key) {
        return key.replace(/([A-Z])/g, ' $1').replace(/^./, function (s) { return s.toUpperCase(); });
    };
%>
                            <% if (locationEntries.length) { %>
                            <div class="panel">
                                <p class="title">Design Locations (<%= chosenLocations.length %> selected)</p>
                                <% if (chosenLocations.length) { %>
                                <table role="presentation" width="100%">
                                    <% chosenLocations.forEach(function(entry) { %>
                                        <tr class="row">
                                            <td class="label"><%= prettyLocation(entry[0]) %></td>
                                            <td class="value">Yes</td>
                                        </tr>
                                    <% }); %>
                                </table>
                                <% } else { %>
                                <div class="message">No design locations were selected.</div>
                                <% } %>
                                <% if (skippedLocations.length) { %>
                                <div class="message" style="margin-top:8px;font-size:12px;">
                                    Not selected: <%= skippedLocations.map(function(e){ return prettyLocation(e[0]); }).join(', ') %>
                                </div>
                                <% } %>
                            </div>
                            <% } %>

                            <% if (data.message) { %>
                            <div class="panel">
                                <p class="title">Customer Message</p>
                                <div class="message"><%= data.message %></div>
                            </div>
                            <% } %>

                            <% if (data.images && data.images.length > 0) { %>
                            <div class="panel">
                                <p class="title">Uploaded Design Images (<%= data.images.length %>)</p>
                                <% data.images.forEach(function(image, index) { %>
                                    <div class="message" style="margin-bottom:8px;"><strong>Image <%= index + 1 %>:</strong> <a href="<%= image %>" target="_blank">View image</a></div>
                                <% }); %>
                            </div>
                            <% } %>
                        </td>
                    </tr>
                    <tr>
                        <td class="footer">
                            <strong>Easy Jackets</strong><br>
                            Automated bulk order notification.
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>

</html>
