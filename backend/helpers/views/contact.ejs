<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body { margin: 0; padding: 0; background: #ffffff; color: #211d18; font-family: Arial, Helvetica, sans-serif; }
    table { border-collapse: collapse; }
    .wrapper { width: 100%; background: #ffffff; padding: 28px 12px; }
    .card { width: 100%; max-width: 620px; margin: 0 auto; background: #fffaf2; border: 1px solid #e4d6c3; border-radius: 18px; overflow: hidden; box-shadow: 0 18px 50px rgba(33,29,24,.10); }
    .hero { background: #11100e; padding: 32px; color: #f5eee3; }
    .eyebrow { margin: 0 0 12px; color: #c4703a; font-size: 11px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; }
    h1 { margin: 0; font-family: Georgia, 'Times New Roman', serif; font-size: 34px; line-height: 1.05; font-weight: 400; letter-spacing: -.03em; }
    .content { padding: 32px; }
    .copy { margin: 0 0 20px; color: #5f574c; font-size: 15px; line-height: 1.75; }
    .panel { background: #f1e6d7; border: 1px solid #e2d2bd; border-radius: 14px; padding: 20px; margin: 20px 0; }
    .label { color: #8a7c6d; font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; margin: 0 0 6px; }
    .value { color: #211d18; font-size: 15px; line-height: 1.6; word-break: break-word; }
    .message { white-space: pre-line; }
    .footer { background: #11100e; color: rgba(245,238,227,.56); padding: 22px 32px; font-size: 12px; line-height: 1.7; }
    .footer strong { color: #f5eee3; }
    @media only screen and (max-width: 520px) { .wrapper { padding: 18px 10px !important; } .hero, .content, .footer { padding-left: 22px !important; padding-right: 22px !important; } h1 { font-size: 29px !important; } }
  </style>
</head>

<body>
  <table class="wrapper" role="presentation" width="100%">
    <tr>
      <td>
        <table class="card" role="presentation" width="100%">
          <tr>
            <td class="hero">
              <p class="eyebrow">Contact Form</p>
              <h1>New customer message.</h1>
            </td>
          </tr>
          <tr>
            <td class="content">
              <p class="copy">A new message was submitted through the Easy Jackets contact form.</p>

              <div class="panel">
                <p class="label">Customer</p>
                <div class="value"><strong><%= data.firstName %> <%= data.lastName %></strong></div>
                <div class="value"><a href="mailto:<%= data.email %>" style="color:#c4703a;text-decoration:none;"><%= data.email %></a></div>
              </div>

              <div class="panel">
                <p class="label">Message</p>
                <div class="value message"><%= data.message %></div>
              </div>

              <p class="copy" style="font-size:13px;color:#8a7c6d;">Submitted: <%= data.date %></p>
            </td>
          </tr>
          <tr>
            <td class="footer">
              <strong>Easy Jackets</strong><br>
              Reply directly to the customer email above.
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>

</html>
