<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quote Request Received - Easy Jackets</title>
    <style>
        body { margin: 0; padding: 0; background: #ffffff; color: #211d18; font-family: Arial, Helvetica, sans-serif; }
        table { border-collapse: collapse; }
        .wrapper { width: 100%; background: #ffffff; padding: 28px 12px; }
        .card { width: 100%; max-width: 680px; margin: 0 auto; background: #fffaf2; border: 1px solid #e4d6c3; border-radius: 18px; overflow: hidden; box-shadow: 0 18px 50px rgba(33,29,24,.10); }
        .hero { background: #11100e; padding: 38px 34px 34px; color: #f5eee3; }
        .eyebrow { margin: 0 0 12px; color: #c4703a; font-size: 11px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; }
        h1 { margin: 0; font-family: Georgia, 'Times New Roman', serif; font-size: 38px; line-height: 1.02; font-weight: 400; letter-spacing: -.03em; }
        .hero-copy { margin: 16px 0 0; color: rgba(245,238,227,.72); font-size: 15px; line-height: 1.7; max-width: 500px; }
        .content { padding: 34px; }
        p { margin: 0 0 18px; color: #5f574c; font-size: 15px; line-height: 1.75; }
        .panel { background: #f1e6d7; border: 1px solid #e2d2bd; border-radius: 14px; padding: 20px; margin: 22px 0; }
        .title { margin: 0 0 14px; color: #c4703a; font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
        .row { border-top: 1px solid rgba(33,29,24,.09); }
        .row:first-of-type { border-top: 0; }
        .label { padding: 10px 0; color: #8a7c6d; font-size: 13px; width: 45%; vertical-align: top; }
        .value { padding: 10px 0; color: #211d18; font-size: 13px; font-weight: 700; text-align: right; vertical-align: top; word-break: break-word; }
        .steps { background: #ffffff; border: 1px solid #eadfce; border-radius: 14px; padding: 20px; margin: 22px 0; }
        .step { color: #433b32; font-size: 14px; line-height: 1.65; padding: 9px 0; border-top: 1px solid rgba(33,29,24,.08); }
        .step:first-of-type { border-top: 0; }
        .footer { background: #11100e; color: rgba(245,238,227,.56); padding: 24px 34px; font-size: 12px; line-height: 1.7; }
        .footer a { color: #c4703a; text-decoration: none; }
        .footer strong { color: #f5eee3; }
        @media only screen and (max-width: 560px) { .wrapper { padding: 18px 10px !important; } .hero, .content, .footer { padding-left: 22px !important; padding-right: 22px !important; } h1 { font-size: 31px !important; } .label, .value { display: block !important; width: 100% !important; text-align: left !important; padding-bottom: 2px !important; } .value { padding-top: 0 !important; } }
    </style>
</head>

<body>
    <table class="wrapper" role="presentation" width="100%">
        <tr>
            <td>
                <table class="card" role="presentation" width="100%">
                    <tr>
                        <td class="hero">
                            <p class="eyebrow">Bulk Order Quote</p>
                            <h1>We received your request.</h1>
                            <p class="hero-copy">Thanks for considering Easy Jackets for your team, school, club, or company order.</p>
                        </td>
                    </tr>
                    <tr>
                        <td class="content">
                            <p>Hi<% if (data.name) { %> <%= data.name %><% } %>,</p>
                            <p>Your bulk quote request is in. Our team will review the details and prepare a response within 24-48 business hours.</p>

                            <div class="panel">
                                <p class="title">Request Summary</p>
                                <table role="presentation" width="100%">
                                    <tr class="row"><td class="label">Product</td><td class="value"><%= data.selectedProduct %></td></tr>
                                    <tr class="row"><td class="label">Quantity</td><td class="value"><%= data.quantity %> pieces</td></tr>
                                    <tr class="row"><td class="label">Front Closure</td><td class="value"><%= data.selectedClosure %></td></tr>
                                    <tr class="row"><td class="label">Lining</td><td class="value"><%= data.selectedLining %></td></tr>
                                    <tr class="row"><td class="label">Zipout Lining</td><td class="value"><%= data.zipoutLining ? 'Yes' : 'No' %></td></tr>
                                    <tr class="row"><td class="label">Flap Closure</td><td class="value"><%= data.flapClosure ? 'Yes' : 'No' %></td></tr>
                                </table>
                            </div>

                            <% if (data.designLocations) { %>
                            <div class="panel">
                                <p class="title">Design Locations</p>
                                <table role="presentation" width="100%">
                                    <% Object.entries(data.designLocations).forEach(function(entry) { %>
                                        <tr class="row">
                                            <td class="label"><%= entry[0].replace(/([A-Z])/g, ' $1').replace(/^./, function(s) { return s.toUpperCase(); }) %></td>
                                            <td class="value"><%= entry[1] ? 'Yes' : 'No' %></td>
                                        </tr>
                                    <% }); %>
                                </table>
                            </div>
                            <% } %>

                            <div class="steps">
                                <p class="title">What happens next</p>
                                <div class="step"><strong>Review:</strong> We review your jacket type, quantity, artwork, and sizing needs.</div>
                                <div class="step"><strong>Quote:</strong> We prepare pricing and production details based on your request.</div>
                                <div class="step"><strong>Contact:</strong> A team member reaches out with next steps.</div>
                                <div class="step"><strong>Samples:</strong> We can discuss samples if your order needs them.</div>
                            </div>

                            <p>Questions before then? Reply to this email and we will help.</p>
                        </td>
                    </tr>
                    <tr>
                        <td class="footer">
                            <strong>Easy Jackets</strong><br>
                            5900 Balcones, Austin TX 78731<br>
                            <a href="https://easyjackets.com">easyjackets.com</a>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>

</html>
