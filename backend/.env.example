# Copy to Coolify -> easyjackets-api-prod -> Environment Variables
# Replace placeholder values with your live MongoDB, payment, email, and storage secrets

NODE_ENV=production
DEV_MODE=production
PORT=8080
# The new storefront's public URL: CORS, order emails and the Stripe return routes /success/{CHECKOUT_SESSION_ID} and /cancel
CLIENT_URL=https://hlfhuuaoepy4uvcbysh4xlk6.145.223.75.247.sslip.io
# The new jacket builder (custom-jacket/ in this repo): "Continue designing" links in share emails
CUSTOM_JACKET_URL=https://custom.145.223.75.247.sslip.io

# the 2026 copy database; never the live site's "Ecommerce" database
MONGO_URL=mongodb+srv://USER:PASS@CLUSTER/easyjackets2026

JWT_SECRET=change-me
# Encrypts the secrets kept in the database (Stripe keys, webhook secrets, SMTP password).
# 32 random bytes, base64. MUST be the same on every backend that uses this database.
# Make one: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_ENCRYPTION_KEY=

STRIPE_SECRET_KEY_LIVE=sk_live_xxx
STRIPE_SECRET_KEY_TEST=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_WEBHOOK_LIVE_SECRET=whsec_xxx

EMAIL_HOST=mail.easyjackets.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your-smtp-user
EMAIL_PASS=your-smtp-password

# Storage: the server's disk (the /app/uploads volume). No S3, so no AWS_S3_* settings.
STORAGE_DRIVER=local
APP_UPLOADS_DIR=/app/uploads
AWS_FILE_PATH=https://api2.easyjackets.com/uploads/
UPLOADS_PUBLIC_BASE_URL=https://api2.easyjackets.com/uploads

# No Braintree: checkout uses Stripe. Without BRAINTREE_* keys its two routes answer 503.

# Optional / currently unused in some paths
GA_PROPERTY_ID=
GA_CLIENT_EMAIL=
GA_PRIVATE_KEY=

# Optional: comma-separated DNS servers for the Atlas SRV lookup if your resolver refuses it
DNS_SERVERS=

# Leave empty: every file lives in this backend's uploads (nothing is fetched from the old live server)
LEGACY_UPLOADS_URL=

# Background remover service (../bg-remover). Unset BG_REMOVER_URL to disable; AUTO_REMOVE_BG=false pauses new uploads.
BG_REMOVER_URL=http://bg-remover:7860
BG_REMOVER_KEY=
BG_REMOVER_MODEL=birefnet-general
AUTO_REMOVE_BG=true
