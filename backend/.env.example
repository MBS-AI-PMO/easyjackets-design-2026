# Copy to Coolify -> easyjackets-api-prod -> Environment Variables
# Replace placeholder values with your live MongoDB, payment, email, and storage secrets

NODE_ENV=production
DEV_MODE=production
PORT=8080
# The new storefront's public URL: CORS, order emails and the Stripe return routes /success/{CHECKOUT_SESSION_ID} and /cancel
CLIENT_URL=https://easyjackets.com
# Base URL of the jacket customiser - used to build "Continue Designing" links in share emails
CUSTOM_JACKET_URL=https://custom.easyjackets.com

# the 2026 copy database; never the live site's "Ecommerce" database
MONGO_URL=mongodb+srv://USER:PASS@CLUSTER/easyjackets2026

JWT_SECRET=change-me

STRIPE_SECRET_KEY_LIVE=sk_live_xxx
STRIPE_SECRET_KEY_TEST=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_WEBHOOK_LIVE_SECRET=whsec_xxx

EMAIL_HOST=mail.easyjackets.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your-smtp-user
EMAIL_PASS=your-smtp-password

# Storage: local (Coolify disk) or s3
STORAGE_DRIVER=local
APP_UPLOADS_DIR=/app/uploads
AWS_FILE_PATH=https://api.easyjackets.com/uploads/
UPLOADS_PUBLIC_BASE_URL=https://api.easyjackets.com/uploads

# Only needed when STORAGE_DRIVER=s3
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET_NAME=easyjacket

# Optional MinIO when STORAGE_DRIVER=s3
# AWS_S3_ENDPOINT=https://storage.easyjackets.com
# AWS_FILE_PATH=https://storage.easyjackets.com/easyjacket/

BRAINTREE_MERCHANT_ID=
BRAINTREE_PUBLIC_KEY=
BRAINTREE_PRIVATE_KEY=

# Optional / currently unused in some paths
GA_PROPERTY_ID=
GA_CLIENT_EMAIL=
GA_PRIVATE_KEY=

# Optional: comma-separated DNS servers for the Atlas SRV lookup if your resolver refuses it
DNS_SERVERS=

# Uploads missing locally are fetched once from here and kept (the live site's uploads)
LEGACY_UPLOADS_URL=

# Background remover service (../bg-remover). Unset BG_REMOVER_URL to disable; AUTO_REMOVE_BG=false pauses new uploads.
BG_REMOVER_URL=http://bg-remover:7860
BG_REMOVER_KEY=
BG_REMOVER_MODEL=birefnet-general
AUTO_REMOVE_BG=true
